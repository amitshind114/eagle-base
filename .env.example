# ============================================================
# eagle-base — environment variable template
# Copy to .env and fill in your values.  NEVER commit .env.
# ============================================================

# ── API authentication ────────────────────────────────────────────────────
# Protects /api/live and /api/paper endpoints.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to disable auth (local dev only — NOT safe for production).
API_KEY=

# ── Active broker (angelone | zerodha | upstox | fyers | iifl) ───────────
BROKER=angelone

# ── App ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
DB_URL=sqlite:///eagle.db

# ── Angel One SmartAPI ───────────────────────────────────────────────────
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# ── Zerodha Kite Connect ─────────────────────────────────────────────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REQUEST_TOKEN=

# ── Upstox V2 ────────────────────────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# ── Fyers API V3 ─────────────────────────────────────────────────────────
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# ── IIFL / 5paisa ────────────────────────────────────────────────────────
IIFL_APP_NAME=
IIFL_APP_SOURCE=
IIFL_USER_ID=
IIFL_PASSWORD=
IIFL_USER_KEY=
IIFL_ENCRYPTION_KEY=
